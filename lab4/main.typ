== Свёрточные блоки

```python
class ConvBlockA(nn.Module):
    def __init__(self, in_c, out_c, k, s, pk, ps):
        super().__init__()
        self.net = nn.Sequential(
            nn.Conv2d(in_c, out_c, k, s, padding=k // 2),
            nn.ReLU(inplace=True),
            nn.MaxPool2d(pk, ps),
        )

class ConvBlockB(nn.Module):
    def __init__(self, in_c, out_c, k, s, pk, ps):
        super().__init__()
        self.net = nn.Sequential(
            nn.Conv2d(in_c, out_c, k, s, padding=k // 2),
            nn.ReLU(inplace=True),
            nn.Conv2d(out_c, out_c, k, 1, padding=k // 2),
            nn.ReLU(inplace=True),
            nn.MaxPool2d(pk, ps),
        )
```

== Класс `ImageCNN`

```python
class ImageCNN(nn.Module):
    def __init__(self, in_c, num_classes, channels, block_type,
                 conv_k, conv_s, pool_k, pool_s, dropout):
        super().__init__()
        Block = ConvBlockA if block_type == 'a' else ConvBlockB
        layers, prev = [], in_c
        for c in channels:
            layers.append(Block(prev, c, conv_k, conv_s, pool_k, pool_s))
            prev = c
        self.features = nn.Sequential(*layers)
        self.head = nn.Sequential(
            nn.AdaptiveAvgPool2d((1, 1)),
            nn.Flatten(),
            nn.Dropout(dropout),
            nn.Linear(prev, num_classes),
        )
```

== Цикл обучения

```python
def train_model(model, train_loader, val_loader, optimizer,
                loss_fn, epochs, patience, min_delta):
    best_val_acc, bad = 0.0, 0
    best_state = copy.deepcopy(model.state_dict())
    history = {'train_loss': [], 'val_loss': [],
               'train_acc':  [], 'val_acc':  []}
    for ep in range(epochs):
        tl, ta = train_one_epoch(model, train_loader, optimizer, loss_fn)
        vl, va = evaluate(model, val_loader, loss_fn)
        history['train_loss'].append(tl); history['train_acc'].append(ta)
        history['val_loss'].append(vl);   history['val_acc'].append(va)
        if va - best_val_acc > min_delta:
            best_val_acc, bad = va, 0
            best_state = copy.deepcopy(model.state_dict())
        else:
            bad += 1
            if bad >= patience: break
    model.load_state_dict(best_state)
    return history, best_val_acc
```

== Метрики

=== Accuracy

$ "accuracy" = frac(1, N) sum_(i=1)^N bb(1)[hat(y)_i = y_i]. $

=== Confusion matrix

Квадратная матрица $C in RR^(10 times 10)$, где $C_(i j)$ ---
число объектов класса $i$, отнесённых сетью к классу $j$.
Диагональ --- правильные предсказания, остальное --- ошибки.

